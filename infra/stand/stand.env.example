# The demo stand's settings: copy to /opt/flagman/stand.env on the server (chmod 600, owner deploy)
# and fill in the empty values there. Never commit the filled file and never put it in GitHub:
# docs/adr/0021, docs/08-demo-stand.md. Generate every secret on the server itself.
# The meaning of each setting is in the repository's .env.example; only the stand's own values are here.

# Where the images come from: ghcr.io/<repository owner in lower case>.
STAND_REGISTRY=
# The stand's domain. Caddy serves admin., app., api. and s3. of it; all four need DNS A records
# pointing at the droplet before the first deploy, or Let's Encrypt cannot issue the certificates.
STAND_DOMAIN=
# Let's Encrypt writes here when a certificate is about to expire.
ACME_EMAIL=

# Prod protections with test data: test payments and demo seeds work, codes never reach the log.
API_ENV=stand
API_LOG_LEVEL=INFO

POSTGRES_USER=flagman
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=flagman
# openssl rand -hex 24
REDIS_PASSWORD=

# openssl rand -hex 32, each different
API_JWT_SECRET=
API_OTP_PEPPER=
# openssl rand -base64 32
API_TOTP_ENCRYPTION_KEY=

# Sign-in without SMS: only these test phones, all with one code (docs/03-security.md).
# python3 -c "import secrets; print(f'{secrets.randbelow(10**6):06d}')"
SMS_BACKEND=fixed
SMS_FIXED_CODE=
# Comma-separated, E.164: +375291111111,+375442222222
SMS_FIXED_PHONES=

# openssl rand -hex 16 and openssl rand -hex 32
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=flagman-private

# Test cards only, no money (docs/adr/0019).
PAYMENTS_PROVIDER=fake
# openssl rand -hex 32
PAYMENTS_WEBHOOK_SECRET=
# openssl rand -base64 32, different from API_TOTP_ENCRYPTION_KEY
PAYMENTS_TOKEN_ENCRYPTION_KEY=

# openssl rand -hex 32, each different
EMULATOR_COMMAND_SECRET=
EMULATOR_TELEMETRY_SECRET=
EMULATOR_CAR_COUNT=30
EMULATOR_SEED=42
# A livelier fleet for a short demo: simulated seconds per real second.
EMULATOR_TIME_SCALE=10

# Staff created by bin/seed.sh with 2FA already set up. An empty email means no such account.
# Password: at least 12 characters. 2FA secret: python3 -c "import pyotp; print(pyotp.random_base32())"
# or `openssl rand 20 | base32`; add it to the authenticator app of whoever shows the stand.
# Changing a value later does not change an existing account: use flagman-staff set-password / reset-totp.
STAND_ADMIN_EMAIL=
STAND_ADMIN_PASSWORD=
STAND_ADMIN_TOTP_SECRET=
STAND_OPERATOR_EMAIL=
STAND_OPERATOR_PASSWORD=
STAND_OPERATOR_TOTP_SECRET=
STAND_TECHNICIAN_EMAIL=
STAND_TECHNICIAN_PASSWORD=
STAND_TECHNICIAN_TOTP_SECRET=

# Space-separated origins the maps load tiles, styles and fonts from (ADR-0003), let through the
# CSP of admin. and app. Empty means OpenFreeMap, the style the images are built with; change it
# together with VITE_MAP_STYLE_URL and EXPO_PUBLIC_MAP_STYLE_URL.
MAP_ORIGINS=

# Days a daily database dump is kept (bin/backup.sh).
BACKUP_KEEP_DAYS=7
