# The stand's edge (docs/adr/0021): HTTPS for four subdomains of STAND_DOMAIN.
# Caddy runs as a non-root user and still binds 80 and 443: Docker lets any user of a container
# bind low ports inside the container's own network namespace.
# MAP_ORIGINS: where the maps load tiles, styles and fonts from (ADR-0003); one origin by default.
{
	email {$ACME_EMAIL}
	# Nothing reconfigures Caddy at runtime, so its admin API stays closed.
	admin off
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	log {
		# Hostnames and status only: client IPs and query strings stay out of the stand's logs.
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>uri query {
					delete code
					delete token
				}
				request>headers delete
				resp_headers delete
			}
		}
	}
}

# A single-page app: unknown paths get index.html; hashed assets are cached for a long time.
(spa) {
	@assets path /assets/* /_expo/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

# The admin panel. Its API calls stay on this origin, like the Vite proxy in development, so the
# staff refresh cookie belongs to admin. and no CORS is needed.
admin.{$STAND_DOMAIN} {
	import common
	@api path /staff/* /admin/*
	handle @api {
		reverse_proxy api:8000
	}
	handle {
		root * /srv/admin
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: {$MAP_ORIGINS:https://tiles.openfreemap.org}; font-src 'self'; connect-src 'self' wss://admin.{$STAND_DOMAIN} {$MAP_ORIGINS:https://tiles.openfreemap.org}; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		import spa
	}
}

# The client web app; on iPhones it stands in for a TestFlight build (docs/adr/0021).
app.{$STAND_DOMAIN} {
	import common
	root * /srv/app
	# React Native Web inserts its styles at runtime, hence 'unsafe-inline' for styles only.
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://s3.{$STAND_DOMAIN} {$MAP_ORIGINS:https://tiles.openfreemap.org}; font-src 'self' data:; connect-src 'self' https://api.{$STAND_DOMAIN} https://s3.{$STAND_DOMAIN} {$MAP_ORIGINS:https://tiles.openfreemap.org}; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self' https://api.{$STAND_DOMAIN}; frame-ancestors 'none'"
	import spa
}

# The API for the app. It sets its own security headers (core/middleware.py).
api.{$STAND_DOMAIN} {
	import common
	reverse_proxy api:8000
}

# Signed links to document photos. The signature covers the host, so the request reaches
# SeaweedFS with s3.STAND_DOMAIN as its Host, which is Caddy's default.
s3.{$STAND_DOMAIN} {
	import common
	reverse_proxy seaweedfs:8333
}
