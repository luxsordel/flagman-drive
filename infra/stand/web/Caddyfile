# The stand's edge (docs/adr/0021): HTTPS for four subdomains of STAND_DOMAIN.
# Caddy runs as a non-root user and still binds 80 and 443: Docker lets any user of a container
# bind low ports inside the container's own network namespace.
# MAP_ORIGINS (stand.env): where the maps load tiles, styles and fonts from (ADR-0003).
{
	email {$ACME_EMAIL}
	# Nothing reconfigures Caddy at runtime, so its admin API stays closed.
	admin off
	# Lines outside the sites' access log that carry a request (an error the error route below
	# fails to handle, for one) go to the default log: the same filter applies to both.
	log default {
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>uri regexp [?].* ""
				request>headers delete
			}
		}
	}
}

(security_headers) {
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
	X-Content-Type-Options "nosniff"
	Referrer-Policy "no-referrer"
}

(common) {
	encode zstd gzip
	# Set before any handler runs, so Caddy's own error responses (a failed upstream, a missing
	# file) carry them too.
	header {
		import security_headers
	}
	# A proxy adds the upstream's headers to those, and the API sends its own: a deletion makes
	# this block wait for the response, so it replaces them and drops the upstream's Server.
	header {
		import security_headers
		-Server
	}
	# Caddy writes an error response past that deferred deletion; the error route drops it again.
	# Caddy logs a handled error at debug level only, so its cause goes to the access line instead.
	handle_errors {
		header -Server
		log_append error {err.message}
		respond "" {err.status_code}
	}
	log {
		# Hostnames, paths and status only: client IPs and query strings stay out of the stand's
		# logs. A query carries a client search, a card binding session or a photo link signature.
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>uri regexp [?].* ""
				request>headers delete
				resp_headers delete
			}
		}
	}
}

# The API. Caddy keeps an idle upstream connection for 2 minutes by default, uvicorn for
# API_KEEP_ALIVE_SECONDS (75 s by default, infra/docker-compose.yml). A request Caddy sends on a
# socket uvicorn is closing fails: Caddy retries only idempotent methods, a POST becomes a 502.
# Caddy has to give up an idle connection first, so it waits less than uvicorn.
(api) {
	reverse_proxy api:8000 {
		transport http {
			keepalive 60s
		}
	}
}

# A single-page app: unknown paths get index.html; hashed assets are cached for a long time.
(spa) {
	@assets path /assets/* /_expo/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

# The admin panel. Its API calls stay on this origin, like the Vite proxy in development, so the
# staff refresh cookie belongs to admin. and no CORS is needed. Document photos come from s3.
admin.{$STAND_DOMAIN} {
	import common
	@api path /staff/* /admin/*
	handle @api {
		import api
	}
	handle {
		root * /srv/admin
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://s3.{$STAND_DOMAIN} {$MAP_ORIGINS:https://tiles.openfreemap.org}; font-src 'self'; connect-src 'self' wss://admin.{$STAND_DOMAIN} {$MAP_ORIGINS:https://tiles.openfreemap.org}; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		import spa
	}
}

# The client web app; on iPhones it stands in for a TestFlight build (docs/adr/0021).
app.{$STAND_DOMAIN} {
	import common
	root * /srv/app
	# React Native Web inserts its styles at runtime, hence 'unsafe-inline' for styles only.
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://s3.{$STAND_DOMAIN} {$MAP_ORIGINS:https://tiles.openfreemap.org}; font-src 'self' data:; connect-src 'self' https://api.{$STAND_DOMAIN} https://s3.{$STAND_DOMAIN} {$MAP_ORIGINS:https://tiles.openfreemap.org}; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self' https://api.{$STAND_DOMAIN}; frame-ancestors 'none'"
	import spa
}

# The API for the app. It sets its own security headers (core/middleware.py).
api.{$STAND_DOMAIN} {
	import common
	import api
}

# Signed links to document photos. The signature covers the host, so the request reaches
# SeaweedFS with s3.STAND_DOMAIN as its Host, which is Caddy's default.
# Only re-encoded photos come from here, and they need nothing from a CSP.
s3.{$STAND_DOMAIN} {
	import common
	header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	reverse_proxy seaweedfs:8333
}
