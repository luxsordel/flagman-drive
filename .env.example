# Copy to .env and fill in the empty values. Never commit .env.
# Secrets: generate locally, e.g. `openssl rand -hex 24`; share real values only via a password manager.

# PostgreSQL + PostGIS
POSTGRES_USER=flagman
POSTGRES_PASSWORD=
POSTGRES_DB=flagman
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=
REDIS_PORT=6379

# API (apps/api). The API also reads the Postgres and Redis values above;
# POSTGRES_HOST / REDIS_HOST default to localhost and are set by docker compose for the container.
API_ENV=dev
API_LOG_LEVEL=INFO
API_PORT=8000
# Optional: comma-separated explicit origins, e.g. http://localhost:8081,http://127.0.0.1:5173
# (the admin dev server runs on 127.0.0.1:5173; localhost is a different origin for CORS)
API_CORS_ORIGINS=
# Optional: timeout in seconds for every Redis call of the API (default 5).
REDIS_TIMEOUT_SECONDS=
# Optional: addresses or networks (CIDR) of the reverse proxy whose X-Forwarded-For uvicorn trusts
# (default 127.0.0.1,::1). Behind Caddy set its container network, otherwise rate limits see every
# client as the proxy. Never "*" while the API port is reachable without the proxy.
FORWARDED_ALLOW_IPS=
# Client sign-in secrets: at least 32 characters each, different from each other.
# Changing API_JWT_SECRET signs everyone out within 15 minutes (access tokens expire);
# changing API_OTP_PEPPER invalidates codes that are being entered right now.
API_JWT_SECRET=
API_OTP_PEPPER=
# Only "log" for now: OTP codes go to the API log (refused with API_ENV=prod).
# Empty: the API runs, but requesting a sign-in code answers 503.
SMS_BACKEND=log
# Staff sign-in: encrypts staff TOTP secrets in the database. 32 random bytes in base64:
# `openssl rand -base64 32`. Changing it makes every staff member set up 2FA again.
API_TOTP_ENCRYPTION_KEY=

# S3-compatible object storage (SeaweedFS)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=flagman-private
S3_PORT=8333

# Car emulator (services/car-emulator). Secrets: at least 32 characters, different from each other.
EMULATOR_COMMAND_SECRET=
EMULATOR_TELEMETRY_SECRET=
# Empty: telemetry goes to the log stub until apps/api can receive webhooks.
EMULATOR_TELEMETRY_URL=
EMULATOR_CAR_COUNT=30
EMULATOR_PORT=8100
