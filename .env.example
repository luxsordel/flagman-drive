# Copy to .env and fill in the empty values. Never commit .env.
# Secrets: generate locally, e.g. `openssl rand -hex 24`; share real values only via a password manager.

# PostgreSQL + PostGIS
POSTGRES_USER=flagman
POSTGRES_PASSWORD=
POSTGRES_DB=flagman
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=
REDIS_PORT=6379

# API (apps/api). The API also reads the Postgres and Redis values above;
# POSTGRES_HOST / REDIS_HOST default to localhost and are set by docker compose for the container.
# Required by docker compose, no default: dev on a developer machine, prod on a server.
API_ENV=
API_LOG_LEVEL=INFO
API_PORT=8000
# Optional: comma-separated explicit origins, e.g. http://localhost:8081,http://127.0.0.1:5173
# (the admin dev server runs on 127.0.0.1:5173; localhost is a different origin for CORS).
# The live fleet of the admin panel (WebSocket, docs/adr/0017) accepts only these origins too.
API_CORS_ORIGINS=
# Optional: timeout in seconds for every Redis call of the API (default 5).
REDIS_TIMEOUT_SECONDS=
# Optional: addresses or networks (CIDR) of the reverse proxy whose X-Forwarded-For uvicorn trusts
# (default 127.0.0.1,::1). Behind Caddy set its container network, otherwise rate limits see every
# client as the proxy. Never "*" while the API port is reachable without the proxy.
FORWARDED_ALLOW_IPS=
# Client sign-in secrets: at least 32 characters each, different from each other.
# Changing API_JWT_SECRET signs everyone out within 15 minutes (access tokens expire);
# changing API_OTP_PEPPER invalidates codes that are being entered right now.
API_JWT_SECRET=
API_OTP_PEPPER=
# No SMS gateway during the pilot (docs/adr/0009):
#   log   - OTP codes go to the API log; development only, refused with API_ENV=prod.
#   fixed - only the test phones below can sign in, all with SMS_FIXED_CODE; nothing is logged.
# Empty: the API runs, but requesting a sign-in code answers 503.
SMS_BACKEND=log
# For SMS_BACKEND=fixed: a random 6-digit code, shared only with the people demoing the pilot
# (python -c "import secrets; print(f'{secrets.randbelow(10**6):06d}')"; one repeated digit or
# a run like 123456 is refused), and comma-separated test phones in E.164,
# e.g. +375291111111,+375442222222.
SMS_FIXED_CODE=
SMS_FIXED_PHONES=
# Staff sign-in: encrypts staff TOTP secrets in the database. 32 random bytes in base64:
# `openssl rand -base64 32`. After changing it, reset 2FA of every staff member
# (`flagman-staff reset-totp`): they set it up again at the next sign-in.
API_TOTP_ENCRYPTION_KEY=

# S3-compatible object storage (SeaweedFS, docs/adr/0005). The API also reads the keys and the bucket;
# without the keys it runs, but client document uploads answer 503.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=flagman-private
S3_PORT=8333
# Optional: where the API reaches the storage (default http://localhost:8333; set by docker compose
# for the container) and the region the requests are signed for (default us-east-1).
S3_ENDPOINT_URL=
S3_REGION=
# Optional: the address clients open signed document links at (default S3_ENDPOINT_URL). The signature
# covers the host, so it must be the address the phone or browser sees. Must be https with API_ENV=prod.
S3_PUBLIC_URL=

# Optional: admission thresholds checked when an operator approves a client's documents.
# Minimum age in years: default 21, cannot be set below 18.
# Minimum years since the driving license was issued: default 2.
KYC_MIN_AGE_YEARS=
KYC_MIN_DRIVING_YEARS=

# Optional: when a car is offered for rent. Minimum charge in percent: default 20.
# Maximum age of the last telemetry snapshot in seconds: default 300; an older one hides the car.
FLEET_MIN_BATTERY_PCT=
FLEET_TELEMETRY_MAX_AGE_SECONDS=
# Optional: clock skew in seconds allowed between the API and telematics (docs/adr/0007),
# for webhook signatures and snapshot times. Default 300, at most 3600.
TELEMATICS_SIGNATURE_TOLERANCE_SECONDS=

# Card payments (apps/api, docs/adr/0019). Empty PAYMENTS_PROVIDER: cards cannot be bound and payments
# answer 503. "fake" is the test provider inside the API (test cards, no money); it needs both values below.
PAYMENTS_PROVIDER=fake
# Signs and checks the payment provider's webhooks: at least 32 characters.
PAYMENTS_WEBHOOK_SECRET=
# Encrypts the provider's card tokens in the database. 32 random bytes in base64, different from
# API_TOTP_ENCRYPTION_KEY: openssl rand -base64 32
PAYMENTS_TOKEN_ENCRYPTION_KEY=
# Optional: clock skew in seconds allowed for webhook signatures. Default 300, at most 3600.
PAYMENTS_WEBHOOK_TOLERANCE_SECONDS=

# Periodic jobs (flagman-worker in apps/api, docs/adr/0013). Optional: days ended client and staff
# sessions are kept before deletion, default 7, at least 1.
AUTH_CLEANUP_RETENTION_DAYS=

# Car emulator (services/car-emulator). Secrets: at least 32 characters, different from each other.
# The API reads both: EMULATOR_TELEMETRY_SECRET checks the telemetry webhooks (without it the API
# answers telemetry with 503 and no car is offered to clients), EMULATOR_COMMAND_SECRET signs the
# staff's car commands (without it commands answer 503).
EMULATOR_COMMAND_SECRET=
EMULATOR_TELEMETRY_SECRET=
# Where the API sends car commands. In Docker Compose empty means the car-emulator service
# (http://car-emulator:8100); for an API run with `uv run` on the host, set http://127.0.0.1:8100.
EMULATOR_URL=
# Optional: seconds a car command waits for the car, default 10, at most 60. Then the staff member
# is told the outcome is unknown.
TELEMATICS_COMMAND_TIMEOUT_SECONDS=
# Where the emulator sends telemetry. In Docker Compose empty means the api service
# (http://api:8000/fleet/telemetry); for an API run with `uv run` on the host, set
# http://host.docker.internal:8000/fleet/telemetry. Outside Compose empty means the log stub.
EMULATOR_TELEMETRY_URL=
# The cars and their ids follow from these two; the API demo seed (`flagman-fleet seed`) reads them
# too, so its cars get the emulator's ids. After changing EMULATOR_SEED reset the database before
# seeding again (apps/api/README.md); a larger EMULATOR_CAR_COUNT only needs the seed run again.
EMULATOR_CAR_COUNT=30
EMULATOR_SEED=42
EMULATOR_PORT=8100
