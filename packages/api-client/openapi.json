{
  "components": {
    "schemas": {
      "ActorType": {
        "enum": ["staff", "client", "system"],
        "title": "ActorType",
        "type": "string"
      },
      "AuditAction": {
        "description": "Every recorded action is listed here, so filtering by action is reliable.\n\nValues are stored as is: renaming one breaks filtering of older events.",
        "enum": ["staff.signed_in", "staff.sign_in_failed"],
        "title": "AuditAction",
        "type": "string"
      },
      "AuditEventOut": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "examples": ["staff.signed_in"],
            "title": "Action",
            "type": "string"
          },
          "actor_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Absent for `system`.",
            "title": "Actor Id"
          },
          "actor_type": {
            "$ref": "#/components/schemas/ActorType"
          },
          "details": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Details",
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "ip_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Keyed hash of the client IP: equal values mean the same address.",
            "title": "Ip Hash"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "target": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AuditEventTarget"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "occurred_at",
          "actor_type",
          "actor_id",
          "action",
          "target",
          "ip_hash",
          "request_id",
          "details"
        ],
        "title": "AuditEventOut",
        "type": "object"
      },
      "AuditEventPage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AuditEventOut"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Absent on the last page.",
            "title": "Next Cursor"
          }
        },
        "required": ["items", "next_cursor"],
        "title": "AuditEventPage",
        "type": "object"
      },
      "AuditEventTarget": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "type": {
            "examples": ["kyc_document"],
            "title": "Type",
            "type": "string"
          }
        },
        "required": ["type", "id"],
        "title": "AuditEventTarget",
        "type": "object"
      },
      "CheckStatus": {
        "enum": ["ok", "fail"],
        "title": "CheckStatus",
        "type": "string"
      },
      "DocumentKind": {
        "description": "Values are stored as is and are part of the API path: renaming one breaks both.",
        "enum": ["license_front", "license_back", "passport", "selfie_with_license"],
        "title": "DocumentKind",
        "type": "string"
      },
      "DocumentUrlOut": {
        "additionalProperties": false,
        "properties": {
          "expires_in": {
            "description": "Seconds the link keeps working.",
            "examples": [300],
            "title": "Expires In",
            "type": "integer"
          },
          "url": {
            "description": "Opens the photo without a token; do not store or share it.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": ["url", "expires_in"],
        "title": "DocumentUrlOut",
        "type": "object"
      },
      "FieldError": {
        "additionalProperties": false,
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": ["loc", "message", "type"],
        "title": "FieldError",
        "type": "object"
      },
      "KycApplicationOut": {
        "additionalProperties": false,
        "description": "No links here: the client asks for one only when it shows the photo.",
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/KycDocumentOut"
            },
            "title": "Documents",
            "type": "array"
          },
          "missing_documents": {
            "description": "Still to upload before the application can be submitted.",
            "items": {
              "$ref": "#/components/schemas/DocumentKind"
            },
            "title": "Missing Documents",
            "type": "array"
          },
          "rejection_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when `rejected`: what to fix before submitting again.",
            "examples": ["The selfie is blurry"],
            "title": "Rejection Reason"
          },
          "status": {
            "$ref": "#/components/schemas/KycStatus"
          },
          "submitted_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Submitted At"
          }
        },
        "required": [
          "status",
          "rejection_reason",
          "submitted_at",
          "documents",
          "missing_documents"
        ],
        "title": "KycApplicationOut",
        "type": "object"
      },
      "KycDocumentOut": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/DocumentKind"
          },
          "uploaded_at": {
            "format": "date-time",
            "title": "Uploaded At",
            "type": "string"
          }
        },
        "required": ["kind", "uploaded_at"],
        "title": "KycDocumentOut",
        "type": "object"
      },
      "KycStatus": {
        "enum": ["not_submitted", "pending", "approved", "rejected"],
        "title": "KycStatus",
        "type": "string"
      },
      "LivenessResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          }
        },
        "required": ["status"],
        "title": "LivenessResponse",
        "type": "object"
      },
      "LogoutRequest": {
        "additionalProperties": false,
        "properties": {
          "refresh_token": {
            "anyOf": [
              {
                "description": "Opaque refresh token.",
                "maxLength": 256,
                "minLength": 32,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Left out by the web client, which sends the cookie instead.",
            "title": "Refresh Token"
          }
        },
        "title": "LogoutRequest",
        "type": "object"
      },
      "OtpRequest": {
        "additionalProperties": false,
        "properties": {
          "phone": {
            "description": "Belarusian mobile number in E.164 format.",
            "examples": ["+375291234567"],
            "pattern": "^\\+375(25|29|33|44)[0-9]{7}$",
            "title": "Phone",
            "type": "string"
          }
        },
        "required": ["phone"],
        "title": "OtpRequest",
        "type": "object"
      },
      "OtpRequestAccepted": {
        "additionalProperties": false,
        "description": "The same for every phone, so the response does not reveal whether a user exists.",
        "properties": {
          "expires_in": {
            "description": "Seconds the code stays valid.",
            "examples": [300],
            "title": "Expires In",
            "type": "integer"
          },
          "resend_after": {
            "description": "Seconds before another code can be requested for this phone.",
            "examples": [60],
            "title": "Resend After",
            "type": "integer"
          }
        },
        "required": ["expires_in", "resend_after"],
        "title": "OtpRequestAccepted",
        "type": "object"
      },
      "OtpVerifyRequest": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "One-time code from the SMS.",
            "examples": ["123456"],
            "pattern": "^[0-9]{6}$",
            "title": "Code",
            "type": "string"
          },
          "device_id": {
            "description": "Generated by the app once per installation and kept in secure storage. Reuse of an old refresh token revokes every session of this device.",
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          },
          "phone": {
            "description": "Belarusian mobile number in E.164 format.",
            "examples": ["+375291234567"],
            "pattern": "^\\+375(25|29|33|44)[0-9]{7}$",
            "title": "Phone",
            "type": "string"
          },
          "refresh_token_transport": {
            "default": "body",
            "description": "`cookie` for the web client: the refresh token is set as an HttpOnly cookie and left out of the response body.",
            "enum": ["body", "cookie"],
            "title": "Refresh Token Transport",
            "type": "string"
          }
        },
        "required": ["phone", "code", "device_id"],
        "title": "OtpVerifyRequest",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "description": "Error response body. Extension members are `request_id` and `errors`.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": ["title", "status"],
        "title": "Problem",
        "type": "object"
      },
      "ReadinessResponse": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CheckStatus"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          }
        },
        "required": ["status", "checks"],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "RefreshRequest": {
        "additionalProperties": false,
        "properties": {
          "refresh_token": {
            "anyOf": [
              {
                "description": "Opaque refresh token.",
                "maxLength": 256,
                "minLength": 32,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Left out by the web client, which sends the cookie instead.",
            "title": "Refresh Token"
          }
        },
        "title": "RefreshRequest",
        "type": "object"
      },
      "TokenPair": {
        "additionalProperties": false,
        "properties": {
          "access_token": {
            "description": "JWT for the `Authorization: Bearer` header.",
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "description": "Seconds the access token stays valid.",
            "examples": [900],
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Single-use: every refresh returns a new one and invalidates this one. Absent when the refresh token travels in the cookie.",
            "title": "Refresh Token"
          },
          "token_type": {
            "const": "Bearer",
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": ["access_token", "expires_in"],
        "title": "TokenPair",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Access token from `POST /auth/otp/verify`.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "FLAGMAN Drive API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/audit-events": {
      "get": {
        "operationId": "list_audit_events_admin_audit_events_get",
        "parameters": [
          {
            "description": "Only events of this staff member.",
            "in": "query",
            "name": "actor_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only events of this staff member.",
              "title": "Actor Id"
            }
          },
          {
            "in": "query",
            "name": "action",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/AuditAction"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Action"
            }
          },
          {
            "description": "Inclusive.",
            "in": "query",
            "name": "occurred_from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive.",
              "title": "Occurred From"
            }
          },
          {
            "description": "Exclusive.",
            "in": "query",
            "name": "occurred_to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exclusive.",
              "title": "Occurred To"
            }
          },
          {
            "description": "`next_cursor` of the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`next_cursor` of the previous page.",
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditEventPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`urn:flagman:problem:access-token-invalid`: sign in as staff."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`urn:flagman:problem:forbidden`: only `admin` reads the audit log."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List audit events, newest first",
        "tags": ["audit"]
      }
    },
    "/auth/logout": {
      "post": {
        "description": "Idempotent: an unknown or already revoked token also gives 204. Clears the cookie. The web client sends `{}` as the body and the refresh token in the cookie.",
        "operationId": "logout_auth_logout_post",
        "parameters": [
          {
            "description": "Web client only; used when the body has no `refresh_token`.",
            "in": "cookie",
            "name": "flagman_refresh",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Web client only; used when the body has no `refresh_token`.",
              "title": "Flagman Refresh"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "End the session of this refresh token",
        "tags": ["auth"]
      }
    },
    "/auth/otp/request": {
      "post": {
        "operationId": "request_otp_auth_otp_request_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpRequestAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`urn:flagman:problem:sign-in-not-allowed`: the pilot runs without SMS and only its test phones can sign in."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many requests, type `urn:flagman:problem:rate-limited`.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "minimum": 0.0,
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`urn:flagman:problem:sign-in-unavailable`: no SMS gateway configured."
          }
        },
        "summary": "Send a one-time sign-in code by SMS",
        "tags": ["auth"]
      }
    },
    "/auth/otp/verify": {
      "post": {
        "operationId": "verify_otp_auth_otp_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`urn:flagman:problem:otp-invalid`: wrong code, the user may retry. `urn:flagman:problem:otp-expired`: request a new code."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many requests, type `urn:flagman:problem:rate-limited`.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "minimum": 0.0,
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Exchange the code for tokens; creates the user on first sign-in",
        "tags": ["auth"]
      }
    },
    "/auth/token/refresh": {
      "post": {
        "description": "The new refresh token comes back the way the old one came. The web client sends `{}` as the body and the refresh token in the cookie.",
        "operationId": "refresh_tokens_auth_token_refresh_post",
        "parameters": [
          {
            "description": "Web client only; used when the body has no `refresh_token`.",
            "in": "cookie",
            "name": "flagman_refresh",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Web client only; used when the body has no `refresh_token`.",
              "title": "Flagman Refresh"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
