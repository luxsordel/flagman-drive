{
  "components": {
    "schemas": {
      "CheckStatus": {
        "enum": ["ok", "fail"],
        "title": "CheckStatus",
        "type": "string"
      },
      "FieldError": {
        "additionalProperties": false,
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": ["loc", "message", "type"],
        "title": "FieldError",
        "type": "object"
      },
      "LivenessResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          }
        },
        "required": ["status"],
        "title": "LivenessResponse",
        "type": "object"
      },
      "LogoutRequest": {
        "additionalProperties": false,
        "properties": {
          "refresh_token": {
            "description": "Opaque refresh token.",
            "maxLength": 256,
            "minLength": 32,
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": ["refresh_token"],
        "title": "LogoutRequest",
        "type": "object"
      },
      "OtpRequest": {
        "additionalProperties": false,
        "properties": {
          "phone": {
            "description": "Belarusian mobile number in E.164 format.",
            "examples": ["+375291234567"],
            "pattern": "^\\+375(25|29|33|44)[0-9]{7}$",
            "title": "Phone",
            "type": "string"
          }
        },
        "required": ["phone"],
        "title": "OtpRequest",
        "type": "object"
      },
      "OtpRequestAccepted": {
        "additionalProperties": false,
        "description": "The same for every phone, so the response does not reveal whether a user exists.",
        "properties": {
          "expires_in": {
            "description": "Seconds the code stays valid.",
            "examples": [300],
            "title": "Expires In",
            "type": "integer"
          },
          "resend_after": {
            "description": "Seconds before another code can be requested for this phone.",
            "examples": [60],
            "title": "Resend After",
            "type": "integer"
          }
        },
        "required": ["expires_in", "resend_after"],
        "title": "OtpRequestAccepted",
        "type": "object"
      },
      "OtpVerifyRequest": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "One-time code from the SMS.",
            "examples": ["123456"],
            "pattern": "^[0-9]{6}$",
            "title": "Code",
            "type": "string"
          },
          "device_id": {
            "description": "Generated by the app once per installation and kept in secure storage. Reuse of an old refresh token revokes every session of this device.",
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          },
          "phone": {
            "description": "Belarusian mobile number in E.164 format.",
            "examples": ["+375291234567"],
            "pattern": "^\\+375(25|29|33|44)[0-9]{7}$",
            "title": "Phone",
            "type": "string"
          }
        },
        "required": ["phone", "code", "device_id"],
        "title": "OtpVerifyRequest",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "description": "Error response body. Extension members are `request_id` and `errors`.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": ["title", "status"],
        "title": "Problem",
        "type": "object"
      },
      "ReadinessResponse": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CheckStatus"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          }
        },
        "required": ["status", "checks"],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "RefreshRequest": {
        "additionalProperties": false,
        "properties": {
          "refresh_token": {
            "description": "Opaque refresh token.",
            "maxLength": 256,
            "minLength": 32,
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": ["refresh_token"],
        "title": "RefreshRequest",
        "type": "object"
      },
      "TokenPair": {
        "additionalProperties": false,
        "properties": {
          "access_token": {
            "description": "JWT for the `Authorization: Bearer` header.",
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "description": "Seconds the access token stays valid.",
            "examples": [900],
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "description": "Single-use: every refresh returns a new one and invalidates this one.",
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "const": "Bearer",
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": ["access_token", "expires_in", "refresh_token"],
        "title": "TokenPair",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FLAGMAN Drive API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/logout": {
      "post": {
        "description": "Idempotent: an unknown or already revoked token also gives 204.",
        "operationId": "logout_auth_logout_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "End the session of this refresh token",
        "tags": ["auth"]
      }
    },
    "/auth/otp/request": {
      "post": {
        "operationId": "request_otp_auth_otp_request_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpRequestAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many requests, type `urn:flagman:problem:rate-limited`.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "minimum": 0.0,
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Send a one-time sign-in code by SMS",
        "tags": ["auth"]
      }
    },
    "/auth/otp/verify": {
      "post": {
        "operationId": "verify_otp_auth_otp_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`urn:flagman:problem:otp-invalid`: wrong code, the user may retry. `urn:flagman:problem:otp-expired`: request a new code."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many requests, type `urn:flagman:problem:rate-limited`.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "minimum": 0.0,
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Exchange the code for tokens; creates the user on first sign-in",
        "tags": ["auth"]
      }
    },
    "/auth/token/refresh": {
      "post": {
        "operationId": "refresh_tokens_auth_token_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "`urn:flagman:problem:refresh-token-invalid`: sign in again."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Rotate the refresh token and get a new access token",
        "tags": ["auth"]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Liveness: the process is up",
        "tags": ["health"]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readiness: the database and Redis are reachable",
        "tags": ["health"]
      }
    }
  }
}
