# Copy to .env.local (not committed). Expo reads it from apps/mobile, not from the repository root.
# EXPO_PUBLIC_* values are built into the app bundle: public settings only, never secrets.

# API origin. Empty: http://localhost:8000 (web and the iOS simulator).
# Android emulator: http://10.0.2.2:8000.
EXPO_PUBLIC_API_URL=

# Map style (MapLibre style JSON). Empty: the OpenFreeMap "liberty" style, the same as in the admin panel.
EXPO_PUBLIC_MAP_STYLE_URL=

# Push notifications (docs/adr/0020): the id of the project on expo.dev (Project settings), which issues
# the app's Expo push tokens. Read by app.config.ts at build time; not a secret, it ends up in the build.
# Without it the app runs, but no phone can turn on push notifications.
EAS_PROJECT_ID=
