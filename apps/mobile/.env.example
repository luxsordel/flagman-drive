# Copy to .env.local (not committed). Expo reads it from apps/mobile, not from the repository root.
# EXPO_PUBLIC_* values are built into the app bundle: public settings only, never secrets.

# API origin. Empty: http://localhost:8000 (web and the iOS simulator).
# Android emulator: http://10.0.2.2:8000.
EXPO_PUBLIC_API_URL=
