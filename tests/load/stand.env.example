# For `npm run load:stand`. Copy to tests/load/stand.env, which git ignores, and fill in from the
# stand's own stand.env (docs/08-demo-stand.md, "Вход на стенд"). Agree on the time with the team first.

# https://api.<the stand's domain>
LOAD_STAND_API_URL=
# https://admin.<the stand's domain>: the fleet stream accepts only its own origins.
LOAD_STAND_ADMIN_ORIGIN=
# Comma-separated, 10 phones from SMS_FIXED_PHONES used by nobody else: the run rents cars on them.
# And the stand's SMS_FIXED_CODE.
LOAD_STAND_PHONES=
LOAD_STAND_OTP_CODE=
# An operator or an admin: STAND_OPERATOR_EMAIL, _PASSWORD and _TOTP_SECRET.
LOAD_STAND_STAFF_EMAIL=
LOAD_STAND_STAFF_PASSWORD=
LOAD_STAND_STAFF_TOTP_SECRET=
